--- a/dlls/kernelbase/volume.c
+++ b/dlls/kernelbase/volume.c
@@ -527,11 +527,38 @@
         char data[1024];
         DIRECTORY_BASIC_INFORMATION *info = (DIRECTORY_BASIC_INFORMATION *)data;
         ULONG ctx = 0, len;
+
+        ULONG prev = 0;
+        int i;
 
         while (!NtQueryDirectoryObject( handle, info, sizeof(data), 1, 0, &ctx, &len ))
+        {
             if(info->ObjectName.Length == 2*sizeof(WCHAR) && info->ObjectName.Buffer[1] == ':')
                 bitmask |= 1 << (info->ObjectName.Buffer[0] - 'A');
+            /* Do not spin forever if the directory context does not advance. */
+            if (ctx == prev) break;
+            prev = ctx;
+        }
+        if (!bitmask)
+        {
+            for (i = 0; i < 26; i++)
+            {
+                WCHAR link[] = L"\\DosDevices\\A:";
+                UNICODE_STRING name;
+                OBJECT_ATTRIBUTES a;
+                HANDLE h;
 
+                link[12] = 'A' + i;
+                RtlInitUnicodeString( &name, link );
+                InitializeObjectAttributes( &a, &name, OBJ_CASE_INSENSITIVE, 0, NULL );
+                if (!NtOpenSymbolicLinkObject( &h, SYMBOLIC_LINK_QUERY, &a ))
+                {
+                    bitmask |= 1 << i;
+                    NtClose( h );
+                }
+            }
+        }
+
         NtClose( handle );
     }
 
